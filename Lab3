RETURNING *;



Part G: Advanced DML Patterns


23. Conditional INSERT
INSERT INTO employees (first_name, last_name, department, salary)
SELECT 'Stanley', 'Hudson', 'Sales', 60000
WHERE NOT EXISTS (
    SELECT 1 FROM employees WHERE first_name = 'Stanley' AND last_name = 'Hudson'
);

24. UPDATE with JOIN logic using subqueries
UPDATE employees e
SET salary = CASE 
    WHEN (SELECT d.budget FROM departments d WHERE d.dept_name = e.department) > 100000 
        THEN salary * 1.10
    ELSE salary * 1.05
END
WHERE e.department IN (SELECT dept_name FROM departments);

25. Bulk operations
WITH new_emps AS (
    INSERT INTO employees (first_name, last_name, department, salary) VALUES 
    ('Kelly', 'Kapoor', 'Customer Service', 40000),
    ('Toby', 'Flenderson', 'HR', 50000),
    ('Kevin', 'Malone', 'Accounting', 45000),
    ('Angela', 'Martin', 'Accounting', 52000),
    ('Oscar', 'Martinez', 'Accounting', 55000)
    RETURNING emp_id
)
UPDATE employees 
SET salary = salary * 1.10 
WHERE emp_id IN (SELECT emp_id FROM new_emps);

26. Data migration simulation
CREATE TABLE IF NOT EXISTS employee_archive (LIKE employees INCLUDING ALL);

WITH moved_rows AS (
    DELETE FROM employees 
    WHERE status = 'Inactive' 
    RETURNING *
)
INSERT INTO employee_archive 
SELECT * FROM moved_rows;

27. Complex business logic
UPDATE projects p
SET end_date = end_date + INTERVAL '30 days'
WHERE budget > 50000 
  AND dept_id IN (
      SELECT d.dept_id 
      FROM departments d 
      JOIN employees e ON d.dept_name = e.department 
      GROUP BY d.dept_id 
      HAVING COUNT(e.emp_id) > 3
  );
